{
  "name": "@muza/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./i18n": "./src/i18n/index.tsx",
    "./platform": "./src/platform/index.ts",
    "./auth/*": "./src/auth/*.tsx",
    "./shell/*": "./src/shell/*.tsx",
    "./views/*": "./src/views/*.tsx",
    "./views/settings/*.css": "./src/views/settings/*.css",
    "./lib/queryTestUtils": "./src/lib/queryTestUtils.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./prefs/*": "./src/prefs/*.ts",
    "./theme/accent": "./src/theme/accent.ts",
    "./theme/themeVars": "./src/theme/themeVars.ts",
    "./theme/ThemeRoot": "./src/theme/ThemeRoot.tsx",
    "./components/DesktopOnly": "./src/components/DesktopOnly.tsx"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "dependencies": {
    "@muza/api-client": "workspace:*",
    "@muza/core": "workspace:*",
    "@muza/ui": "workspace:*",
    "@tanstack/react-query": "^5.101.4"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^29.1.1",
    "vitest": "^4.1.10"
  }
}
